# Copy to .env.deploy (git-ignored) and fill in. Nothing else is needed to deploy:
#   npm run deploy:cos
#
# The domain the exported HTML advertises in og:image / twitter:image.
# No trailing slash. Leave it out to keep the built-in default.
NEXT_PUBLIC_SITE_URL=https://gen3d.example.com

# CAM sub-account key, NOT the Tencent Cloud root account key.
# Minimum policy: cos:PutObject / GetObject / DeleteObject / GetBucket(list) on this bucket only.
COS_SECRET_ID=
COS_SECRET_KEY=

# Bucket name as shown in the console, including the APPID suffix.
COS_BUCKET=gen3d-inspector-1250000000

# ap-hongkong  -> works today, no ICP filing, mainland latency ~50-120 ms
# ap-guangzhou / ap-shanghai / ap-beijing -> needs an ICP filing first
COS_REGION=ap-hongkong

# Optional. Key prefix inside the bucket, e.g. gen3d -> s3-style gen3d/index.html
COS_PREFIX=

# Optional. Custom domain bound to the bucket/CDN; only used for the summary line
# and to scope the CORS rule to one origin.
COS_CDN_HOST=
